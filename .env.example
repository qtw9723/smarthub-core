# ── Frontend ──
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Backend (Express / 러너) ──
# 외부 에디션(Supabase): hub_* 테이블만 접근한다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 앱 접근 비밀번호(게이트)
APP_PASSWORD=
PORT=3001

# 정시 트리거 인증 (Bearer)
CRON_SECRET=

# GitHub Actions 워크플로우 디스패치용 (Actions: write 스코프)
GITHUB_TOKEN=
GITHUB_REPO=your-account/smarthub-core

# 러너 대상 허브 (기본 delivery)
HUB_KEY=delivery
# 실패 알림 메일 하단 링크에 쓰이는 앱 주소
HUB_URL=

# 실패 알림 메일 발신 계정(선택 — 없으면 메일은 생략)
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=

# ── 모듈별 설정 (해당 모듈을 쓸 때만) ──
# grafana-reports: 환경(소스)은 화면에서 추가하며, 아래는 소스에 값이 없을 때의 기본값
GRAFANA_URL=
GRAFANA_TOKEN=
PROM_UID=
ES_UID=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
GRAFANA_EMAIL_FROM=
GRAFANA_EMAIL_PASSWORD=
GRAFANA_EMAIL_TO=
# doc-to-api: 자유형식 문서 추출을 맡길 외부 파서(OpenAPI는 불필요)
DOC_PARSE_URL=
DOC_PARSE_KEY=
DOC_TO_API_HOURLY_LIMIT=

# DB 마이그레이션 적용용 (Management API)
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# ── 사내 에디션 전용 (k8s 매니페스트·Secret이 넣는다 — 로컬 시험 때만 여기에) ──
# SMARTHUB_EDITION=internal
# DATABASE_URL=
# ATTACHMENTS_DIR=
# ATTACHMENT_SIGNING_SECRET=
# TEAM_HOST_SUFFIX=
# K8S_NAMESPACE=
# CHECKER_CRONJOB=
# 테스트·CI 전용 변수(TEST_*·DIFF_DATABASE_URL 등)는 각 스크립트 머리 주석 참고.
APP_BASE_URL=
