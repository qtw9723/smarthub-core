{
  "name": "smarthub-core",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"node server/index.js\"",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node scripts/migrate.mjs",
    "test:db": "vitest run --config vitest.db.config.js",
    "lint:migrations": "node scripts/migrate/lint-cli.mjs",
    "build:demo": "VITE_DEMO=true vite build --outDir /tmp/sh-dist && rm -rf web && mkdir web && cp -r /tmp/sh-dist/* web/ && cp vercel.demo.json web/vercel.json"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.101.1",
    "cmdk": "^1.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.22.3",
    "lucide-react": "^1.7.0",
    "nodemailer": "10.2.1",
    "pg": "^8.23.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "7.18.4",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.60.0",
    "supertest": "^7.0.0",
    "vite": "^8.0.1",
    "vitest": "^3.2.3"
  },
  "description": "팀=허브, 기능=모듈로 나눈 업무 자동화 플랫폼 — 한 코드·두 에디션(외부 Supabase / 사내 Postgres) 발췌본",
  "license": "MIT"
}
